<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="Wallet_Main.MonthlySummaryPage"
             xmlns:local="clr-namespace:Wallet_Main"
             BackgroundColor="#141824"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:Wallet_lib;assembly=Wallet_lib"
             NavigationPage.HasNavigationBar="False"
             x:DataType="local:MonthlySummaryViewModel"
             xmlns:strings="clr-namespace:Wallet_Main.Resources.Strings">    

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.RowSpan="3"
        StrokeThickness="0">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1C2336" Offset="0"/>
                    <GradientStop Color="#141824" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

        </Border>
        <!-- HEADER -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,30,0,25">
           
            <Label Text="{x:Static strings:AppResources.SummaryYourMonth}"
                   TextColor="#00E5C3"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="{Binding SummaryMonth}"
                   TextColor="White"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="{x:Static strings:AppResources.SummaryLetSee}"
                   TextColor="#9FA8B4"
                   FontSize="14"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>


        <!-- CONTENT -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Spacing="22">

                <!-- SAVINGS CARD -->
                <Border BackgroundColor="#1E2533"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="25">

                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,6"
                                Opacity="0.35"
                                Radius="14"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                        <Label Text="{x:Static strings:AppResources.MonthlyBalance}"
                               TextColor="#9FA8B4"
                               FontSize="14"
                               HorizontalOptions="Center"/>

                        <Label Text="{Binding Balance,StringFormat='{0:C0}'}"
                               TextColor="#00E5C3"
                               FontSize="40"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>

                    </VerticalStackLayout>

                </Border>


                <!-- INCOME / EXPENSE -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">

                    <!-- INCOME -->
                    <Border BackgroundColor="#1E2533"
            StrokeShape="RoundRectangle 22"
            Padding="20">

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                            <!-- HEADER -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{x:Static strings:AppResources.Incomes}"
           TextColor="#9FA8B4"
           FontSize="13"
           FontAttributes="Bold"/>

                                <Border HeightRequest="2" 
            WidthRequest="60" 
            HorizontalOptions="Start" 
            StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="1"/>
                                    </Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#4CAF50" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </VerticalStackLayout>

                            <!-- VALUE -->
                            <Label Grid.Row="1"
                   Text="{Binding Income, StringFormat='{0:C0}'}"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"/>

                            <!-- TREND -->
                            <Border Grid.Row="2"
                    BackgroundColor="#203A2C"
                    StrokeShape="RoundRectangle 12"
                    Padding="8,4"
                    HorizontalOptions="Start">

                                <HorizontalStackLayout Spacing="4">

                                    <Label Text="{Binding IncomeTrendIcon}"
                           TextColor="{Binding IncomeTrendColor}"
                           FontSize="13"
                           FontAttributes="Bold"/>

                                    <Label Text="{Binding IncomeTrendText}"
                           TextColor="{Binding IncomeTrendColor}"
                           FontSize="12"
                           FontAttributes="Bold"/>

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- EXPENSES -->
                    <Border Grid.Column="1"
            BackgroundColor="#1E2533"
            StrokeShape="RoundRectangle 22"
            Padding="20">

                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                            <VerticalStackLayout Spacing="2">
                                <Label Text="{x:Static strings:AppResources.Expenses}"
                                   TextColor="#9FA8B4"
                                   FontSize="13"
                                   FontAttributes="Bold"/>

                                <Border HeightRequest="2" 
                                        WidthRequest="50" 
                                        HorizontalOptions="Start" 
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="1"/>
                                    </Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#EF5350" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </VerticalStackLayout>

                            <Label Grid.Row="1"
                   Text="{Binding Expenses, StringFormat='{0:C0}'}"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"/>

                            <Border Grid.Row="2"
                    BackgroundColor="#3A2020"
                    StrokeShape="RoundRectangle 12"
                    Padding="8,4"
                    HorizontalOptions="Start">
                               

                                <HorizontalStackLayout Spacing="4">

                                    <Label Text="{Binding ExpenseTrendIcon}"
                           TextColor="{Binding ExpenseTrendColor}"
                           FontSize="13"
                           FontAttributes="Bold"/>

                                    <Label Text="{Binding ExpenseTrendText}"
                           TextColor="{Binding ExpenseTrendColor}"
                           FontSize="12"
                           FontAttributes="Bold"/>

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </Border>

                </Grid>

                <Grid>

                    <!-- EMPTY STATE -->
                    <Border BackgroundColor="#1B2233"
            StrokeShape="RoundRectangle 20"
            Padding="25">

                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                         Binding="{Binding AreThereExpenses}"
                         Value="True">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">

                            <Label Text="🎉"
                   FontSize="40"
                   HorizontalOptions="Center"/>

                            <Label Text="{x:Static strings:AppResources.Congratulations}"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

                            <Label Text="{x:Static strings:AppResources.SummaryNoExpenses}"
                   TextColor="#9FA8B4"
                   FontSize="14"
                   HorizontalTextAlignment="Center"/>

                            <Label Text="{x:Static strings:AppResources.SummaryNoExpenses2}"
                   TextColor="#00E5C3"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

                        </VerticalStackLayout>

                    </Border>


                    <!-- PIE CHART -->
                    <Border BackgroundColor="#1B2233"
        StrokeShape="RoundRectangle 20"
        Padding="15"
        HeightRequest="350">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding AreThereExpenses}" Value="False">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid RowDefinitions="Auto, *">

                            <VerticalStackLayout Margin="0,0,0,15" Spacing="6">

                                <Label Text="{x:Static strings:AppResources.SummaryExpenseStructure}"
           TextColor="White"
           FontSize="18"
           FontAttributes="Bold"/>

                                <Label Text="{x:Static strings:AppResources.SummaryExpenseStructureDescription}"
           TextColor="#9FA8B4"
           FontSize="12"/>

                                <Border HeightRequest="3" 
            WidthRequest="60" 
            HorizontalOptions="Start" 
            StrokeThickness="0"
            Margin="0,4,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="2"/>
                                    </Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5C3" Offset="0"/>
                                            <GradientStop Color="#1B2233" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                            </VerticalStackLayout>

                            <Grid HeightRequest="300" Grid.Row="1">
                                
                                <lvc:PieChart Series="{Binding Series}"
                  AnimationsSpeed="00:00:00.500"
                     
                  BackgroundColor="#1B2233"/>

                                <!-- CENTER PANEL -->
                                <VerticalStackLayout HorizontalOptions="Center"
                         VerticalOptions="Center"               
                         InputTransparent="True"
                         Spacing="4">
                                    

                                    <!-- ICON -->
                                    <Label Text="{Binding CenterIcon}"
                                       FontSize="26"
                                       HorizontalOptions="Center"/>

                                    <!-- NAME -->
                                    <Label Text="{Binding CenterTitle}"
                                       FontSize="13"
                                       TextColor="#B0BEC5"
                                       HorizontalOptions="Center"/>

                                    <!-- VALUE -->
                                    <Label Text="{Binding CenterValue, StringFormat='{0:C0}'}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>

                                    <!-- DEFAULT TEXT -->
                                    <VerticalStackLayout IsVisible="{Binding IsCategorySelected}"
                                        Spacing="2">

                                        <Label Text="Suma wydatków"
                                           TextColor="#B0BEC5"
                                           FontSize="12"
                                           HorizontalOptions="Center"/>

                                        <Label Text="{Binding Expenses, StringFormat='{0:C0}'}"
                                           TextColor="White"
                                           FontSize="24"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>

                            </Grid>
                        </Grid>

                    </Border>

                </Grid>
                <Border BackgroundColor="#1B2233"
                        StrokeShape="RoundRectangle 20"
                        Padding="20">

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">

                            <VerticalStackLayout Grid.Column="0" Spacing="4">

                                <Label Text="{x:Static strings:AppResources.YourBudgets}"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="White"/>

                                <Label Text="{x:Static strings:AppResources.YourBudgetsDescription}"
               TextColor="#9FA8B4"
               FontSize="12"/>

                                <Border HeightRequest="3" 
                WidthRequest="80" 
                HorizontalOptions="Start" 
                StrokeThickness="0"
                Margin="0,4,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="2"/>
                                    </Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5C3" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                            </VerticalStackLayout>

                            <Border Grid.Column="1"
            BackgroundColor="#263046"
            StrokeShape="RoundRectangle 10"
            Padding="8,3"
            VerticalOptions="Start">
                                <Label Text="{Binding BudgetSummary}"
               FontSize="13"
               TextColor="#4CAF50"/>
                            </Border>

                        </Grid>
                        <Grid>
                            <Border
    IsVisible="{Binding ThereAreNotBudgets}"
    BackgroundColor="#1E2533"
    Stroke="#2F3A4F"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 16"
    Padding="30"
    Margin="0,10">

                                <VerticalStackLayout
        Spacing="12"
        HorizontalOptions="Center"
        VerticalOptions="Center">

                                    <!-- ICON -->
                                    <Label
            Text="🎯"
            FontSize="36"
            HorizontalOptions="Center"/>

                                    <!-- TITLE -->
                                    <Label
            Text="Nie masz jeszcze budżetów"
            TextColor="White"
            FontSize="16"
            FontAttributes="Bold"
            HorizontalOptions="Center"/>

                                    <!-- DESCRIPTION -->
                                    <Label
            Text="{x:Static strings:AppResources.YourBudgetsDescription}"
            TextColor="#9CA3AF"
            FontSize="13"
            HorizontalTextAlignment="Center"/>

                                    <!-- BUTTON -->
                                    <Button
            Text="{x:Static strings:AppResources.AddBudget}"
            BackgroundColor="#00BFA5"
            TextColor="Black"
            CornerRadius="20"
            Padding="18,8"
            Clicked="Add_Budget_Clicked"/>

                                </VerticalStackLayout>

                            </Border>

                            <ScrollView IsVisible="{Binding ThereAreNotBudgets, Converter={toolkit:InvertedBoolConverter}}"
                                Orientation="Horizontal" HorizontalScrollBarVisibility="Never">

                            <HorizontalStackLayout
        BindableLayout.ItemsSource="{Binding Budgets}"
        Spacing="14"
        Padding="8,0,8,14">

                                <BindableLayout.ItemTemplate>

                                    <DataTemplate x:DataType="models:BudgetWrapper">
                                        

                                        <Border
                                            WidthRequest="220"
                                            BackgroundColor="#263046"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="0">

                                            <VerticalStackLayout Spacing="0">

                                                <!-- SUCCESS BAR -->
                                                <Border
                                                    IsVisible="{Binding IsInBudget}"
                                                    BackgroundColor="#1F3D2B"
                                                    StrokeShape="RoundRectangle 16,16,0,0"
                                                    Padding="8,4">

                                                    <HorizontalStackLayout Spacing="6">

                                                        <Label Text="✓"
                                                           TextColor="#4CAF50"
                                                           FontAttributes="Bold"
                                                           FontSize="12"/>

                                                            <Label Text="{x:Static strings:AppResources.SummaryGoalAchieved}"
                                                           FontSize="12"
                                                           TextColor="#4CAF50"/>

                                                    </HorizontalStackLayout>

                                                </Border>
                                                <Border
                                                    IsVisible="{Binding IsInBudget, Converter={toolkit:InvertedBoolConverter}}"
                                                    BackgroundColor="#3B1F1F"
                                                    StrokeShape="RoundRectangle 16,16,0,0"
                                                    Padding="8,4">

                                                    <HorizontalStackLayout Spacing="6">

                                                        <Label Text="❌"
                                                        FontSize="12"/>

                                                            <Label Text="{x:Static strings:AppResources.Summarybudgetexceeded}"
                                                           FontSize="12"
                                                           TextColor="#EF5350"/>

                                                    </HorizontalStackLayout>

                                                </Border>


                                                <!-- CONTENT -->
                                                <VerticalStackLayout Padding="16" Spacing="12">

                                                    <!-- HEADER -->
                                                    <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="10">

                                                        <!-- ICON -->
                                                        <Border
                    BackgroundColor="{Binding Budget.Category.Color}"
                    StrokeShape="RoundRectangle 14"
                    HeightRequest="36"
                    WidthRequest="36">

                                                            <Label
                        Text="{Binding Budget.Category.Icon}"
                        FontSize="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

                                                        </Border>

                                                        <!-- CATEGORY -->
                                                        <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="2">

                                                            <Label
                        Text="{Binding Budget.Category.Name}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        LineBreakMode="TailTruncation"/>

                                                            <Label FontSize="12">
                                                                <Label.FormattedText>
                                                                    <FormattedString>

                                                                        <Span
                                    Text="{Binding Spent, StringFormat='{0:C0}'}"
                                    TextColor="White"
                                    FontAttributes="Bold"/>

                                                                        <Span
                                    Text=" / "
                                    TextColor="#9CA3AF"/>

                                                                        <Span
                                    Text="{Binding Budget.Goal, StringFormat='{0:C0}'}"
                                    TextColor="#9CA3AF"/>

                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>

                                                        </VerticalStackLayout>

                                                    </Grid>


                                                    <!-- PROGRESS -->
                                                    <Border
                BackgroundColor="#2E3748"
                StrokeShape="RoundRectangle 8"
                HeightRequest="10">

                                                        <ProgressBar
                    Progress="{Binding Percentage}"
                    ProgressColor="{Binding ProgressColor}"
                    BackgroundColor="Transparent"/>

                                                    </Border>



                                                        <Label
                    Text="{Binding Percentage, StringFormat='{0:P0}'}"
                    TextColor="#9CA3AF"
                    FontSize="11"/>



                                                    

                                                </VerticalStackLayout>

                                            </VerticalStackLayout>

                                        </Border>

                                    </DataTemplate>

                                </BindableLayout.ItemTemplate>

                            </HorizontalStackLayout>

                        </ScrollView>
                        </Grid>

                    </VerticalStackLayout>

                </Border>
                <Border BackgroundColor="#1B2233"
        StrokeShape="RoundRectangle 20"
        Padding="20">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">

                        
                        <Label Grid.Column="0"
               Text="🔥"
               FontSize="36"
               VerticalOptions="Center"/>

                       
                        <VerticalStackLayout Grid.Column="1"
                             Spacing="2"
                             VerticalOptions="Center">

                            
                            <VerticalStackLayout Grid.Column="1"
                             Spacing="4"
                             VerticalOptions="Center">

                                <Label Text="{x:Static strings:AppResources.SummarySavingsStreak}"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White"/>

                                <Border HeightRequest="3" 
                                    WidthRequest="50" 
                                    HorizontalOptions="Start" 
                                    StrokeThickness="0"
                                    Margin="0,0,0,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="2"/>
                                    </Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00E5C3" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Label Text="{Binding SavingStreak}"
FontSize="26"
FontAttributes="Bold"
TextColor="#00E5C3"/>

                                <Label Text="{x:Static strings:AppResources.SummaryMonthsInRow}"
FontSize="12"
TextColor="#9FA8B4"/>

                            </VerticalStackLayout>

                           

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </ScrollView>


        <!-- BUTTON -->
        <Button Grid.Row="2"
                Text="{x:Static strings:AppResources.SummaryGoBackToWallet}"
                BackgroundColor="#00E5C3"
                TextColor="#141824"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="55"
                CornerRadius="28"
                Margin="0,25,0,15"
                Command="{Binding Close_LogicCommand}">

            <Button.Shadow>
                <Shadow Brush="#00E5C3"
                        Offset="0,6"
                        Opacity="0.5"
                        Radius="12"/>
            </Button.Shadow>

        </Button>

    </Grid>

</ContentPage>