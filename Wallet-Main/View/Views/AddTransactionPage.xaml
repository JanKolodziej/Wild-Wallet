<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wallet_Main.AddTransactionPage"
             xmlns:local="clr-namespace:Wallet_Main"
             xmlns:models="clr-namespace:Wallet_lib;assembly=Wallet_lib"
             x:DataType="local:AddTransactionViewModel"
             BackgroundColor="#1A1F2B"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:strings="clr-namespace:Wallet_Main.Resources.Strings">
    
    <Grid RowDefinitions="*, Auto">

        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="25">

                <Label Text="{x:Static strings:AppResources.EnterTheAmount}" 
                       TextColor="Gray" 
                       HorizontalOptions="Center" 
                       FontSize="14"/>

                <Border StrokeShape="RoundRectangle 20"
                        StrokeThickness="2"
                        Stroke="#2E3748"
                        BackgroundColor="#212735"
                        HeightRequest="100"
                        Padding="20,0">

                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsAmountValid}" Value="False">
                            <Setter Property="Stroke" Value="#EF5350"/>
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsAmountValid}" Value="True">
                            <Setter Property="Stroke" Value="#00BFA5"/>
                        </DataTrigger>
                    </Border.Triggers>

                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0" 
                               Text="{Binding IsoCurencySymbol}" 
                               TextColor="#00BFA5" 
                               FontSize="24" 
                               VerticalOptions="Center" 
                               FontAttributes="Bold"
                               Margin="0,0,10,0"/>

                        <Entry Grid.Column="1"
                               Text="{Binding Amount}" 
                               Placeholder="0.00" 
                               PlaceholderColor="#4B5563"
                               TextColor="White"
                               FontSize="40"
                               Margin="0,0,0,10"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"/>
                    </Grid>
                </Border>

                <Label Text="{x:Static strings:AppResources.TransactionDetails}" 
                       TextColor="Gray" 
                       Margin="0,10,0,0" 
                       FontSize="14" 
                       FontAttributes="Bold"/>

                <VerticalStackLayout Spacing="15">

                    <Border Style="{StaticResource ElevatedCardBorderStyle}" Padding="15,5">
                        <Grid RowDefinitions="Auto, Auto">
                            <Label Text="{x:Static strings:AppResources.Title}" TextColor="#6B7280" FontSize="11"/>
                            <Entry Grid.Row="1" 
                                   Text="{Binding Title}" 
                                   Placeholder="{x:Static strings:AppResources.TitleExample}" 
                                   TextColor="White"
                                   BackgroundColor="Transparent"
                                   FontSize="16"/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                        <Border Grid.Column="0" Style="{StaticResource ElevatedCardBorderStyle}" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="{x:Static strings:AppResources.Date_Time}" TextColor="#6B7280" FontSize="11"/>
                                <DatePicker Date="{Binding Date}" 
                                            TextColor="White" 
                                            Format="dd.MM.yyyy"
                                            BackgroundColor="Transparent"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ElevatedCardBorderStyle}" Padding="10">
                            <VerticalStackLayout>
                                <Label Text="{x:Static strings:AppResources.Account}" TextColor="#6B7280" FontSize="11"/>
                                <Picker ItemsSource="{Binding Accounts}" 
                                        ItemDisplayBinding="{Binding Name}" 
                                        TextColor="White"
                                        TitleColor="#4B5563"
                                        BackgroundColor="Transparent"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource ElevatedCardBorderStyle}" Padding="15,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Show_Category_PopUpCommand}"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="10">
                                <Label Text="{x:Static strings:AppResources.Category}" TextColor="#6B7280" FontSize="11"/>
                                <HorizontalStackLayout Spacing="20">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 30"
                                    HeightRequest="40" WidthRequest="40"
                                    BackgroundColor="{Binding SelectedCategory.Color}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center">
                                        <Label Text="{Binding SelectedCategory.Icon}" 
                                       FontSize="25" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"
                                          Margin="0,0,0,5" />
                                    </Border>
                                    <Label Text="{Binding SelectedCategory.Name}"  TextColor="White" Margin="0,7"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ElevatedCardBorderStyle}" 
                            Padding="15,10" 
                            IsVisible="{Binding IsNewTransaction}" >
                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="{x:Static strings:AppResources.ScheduledTransaction}" 
                                       TextColor="White" 
                                       FontSize="14"/>
                                    <Label Text="{x:Static strings:AppResources.ScheduledTransactionDescribtion}" 
                                       TextColor="#6B7280" 
                                       FontSize="11"/>
                                </VerticalStackLayout>

                                <Switch Grid.Column="1" 
                                IsToggled="{Binding IsAutomatedTransaction}"
                                OnColor="#00BFA5"
                                ThumbColor="White"/>
                            </Grid>

                            <VerticalStackLayout 
                                IsVisible="{Binding IsAutomatedTransaction}"
                             Spacing="5">

                                <BoxView HeightRequest="1" Color="#2E3748" Margin="0,5"/>
                                <Label Text="{x:Static strings:AppResources.Frequency}" TextColor="#6B7280" FontSize="11"/>

                                <Picker SelectedIndex="{Binding Frequency}"
                                    TextColor="White"
                                    TitleColor="#4B5563"
                                    Title="{x:Static strings:AppResources.ChooseFrequency}"
                                    BackgroundColor="Transparent" 
                                        ItemsSource="{Binding TypesFrequency}"/>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" 
                Padding="20" 
                BackgroundColor="#262D3D" 
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20,20,0,0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-5" Opacity="0.3" Radius="10"/>
            </Border.Shadow>

            <Button Text="{x:Static strings:AppResources.SaveTransaction}" 
                    Command="{Binding AddCommand}" 
                    IsEnabled="{Binding IsAmountValid}"
                    BackgroundColor="#2C3448"
                    TextColor="Gray"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="55">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter Property="BackgroundColor" Value="#2C3448" />
                        <Setter Property="TextColor" Value="Gray" />
                    </Trigger>
                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                        <Setter Property="BackgroundColor" Value="#00BFA5" />
                        <Setter Property="TextColor" Value="White" />
                    </Trigger>
                </Button.Triggers>
            </Button>
        </Border>

    </Grid>
</ContentPage>