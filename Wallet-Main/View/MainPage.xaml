<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Wallet_Main"
             x:Class="Wallet_Main.MainPage"
             xmlns:models="clr-namespace:Wallet_lib;assembly=Wallet_lib"
             BackgroundColor="#1A1F2B"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:DataType="local:MainPageViewModel"
             xmlns:strings="clr-namespace:Wallet_Main.Resources.Strings">

    <Grid>
        <CollectionView ItemsSource="{Binding GroupedTransactionsList}" Grid.Row="1"
                        IsGrouped="True"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            

            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="20,10,20,20">

                    <Border StrokeShape="RoundRectangle 25"
                        BackgroundColor="#252A36"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        Margin="0,0,0,15"
                        HeightRequest="50">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Opacity="0.3" Radius="8"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="50, 140, 50">

                            <Button Grid.Column="0"
                                Text="&#x276E;" 
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#80CBC4"
                                BackgroundColor="Transparent"
                                Command="{Binding Previous_MonthCommand}" />

                            <Label Grid.Column="1"
                               Text="{Binding DateLabel}"
                               TextColor="White"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextTransform="Uppercase" />

                            <Button Grid.Column="2"
                                Text="&#x276F;"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#80CBC4"
                                BackgroundColor="Transparent"
                                Command="{Binding Next_MonthCommand}" />
                        </Grid>
                    </Border>


                    <Border Style="{StaticResource ElevatedCardBorderStyle}" >
                    <Grid HeightRequest="200">

                        <lvc:CartesianChart 
                            Series="{Binding SeriesList}" 
                            XAxes="{Binding XAxes}" 
                            YAxes="{Binding YAxes}"
                            LegendPosition="Hidden"
                            TooltipPosition="Top"
                            BackgroundColor="#273446"
                            Opacity="1">
                        </lvc:CartesianChart>

                        <Border IsVisible="{Binding ZeroTransactions}"
                        BackgroundColor="#CC1A1F2B" 
                        StrokeThickness="0"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        ZIndex="99">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" Padding="30">
                                <Label Text="📊" FontSize="50" HorizontalOptions="Center"/>

                                    <Label Text="{x:Static strings:AppResources.CollectingData}"
                                   TextColor="White" 
                                   FontSize="20" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center"/>

                                    <Label Text="{x:Static strings:AppResources.ToUnlockChart}"
                                    TextColor="#B0BEC5" 
                                    FontSize="14" 
                                    HorizontalTextAlignment="Center" 
                                    HorizontalOptions="Center"/>

                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">

                        <Border Grid.Column="0" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#43A047" Offset="0.0" />
                                    <GradientStop Color="#1B5E20" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#43A047" Offset="0,4" Opacity="0.5" Radius="8"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="#33FFFFFF" HeightRequest="28" WidthRequest="28" StrokeThickness="0" Margin="0,0,10,0">
                                        <Label Text="↗" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,2,2"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{x:Static strings:AppResources.Incomes}" TextColor="#E8F5E9" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" TextTransform="Uppercase"/>
                                </Grid>
                                <Label Text="{Binding Income, StringFormat='{0:C0}'}" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="15">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E53935" Offset="0.0" />
                                    <GradientStop Color="#B71C1C" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#E53935" Offset="0,4" Opacity="0.5" Radius="8"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" BackgroundColor="#33FFFFFF" HeightRequest="28" WidthRequest="28" StrokeThickness="0" Margin="0,0,10,0">
                                        <Label Text="↘" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="2,0,0,2"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{x:Static strings:AppResources.Expenses}" TextColor="#FFEBEE" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" TextTransform="Uppercase"/>
                                </Grid>
                                <Label Text="{Binding Expenses, StringFormat='{0:C0}'}" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                    <VerticalStackLayout Spacing="10" Margin="0,15,0,5" IsVisible="{Binding HasBudgets}">

                        <Grid ColumnDefinitions="*, Auto" Margin="15,0">
                            <Label Grid.Column="0" Text="Twoje Budżety" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                            <Label Grid.Column="1" Text="🎯" FontSize="14"/>
                        </Grid>

                        <ScrollView Orientation="Horizontal" >
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding BudgetWrapperList}" 
                               Spacing="15" 
                               Padding="15,0,15,15">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="local:BudgetWrapperDisplay">

                                        <Border Style="{StaticResource ElevatedCardBorderStyle}" 
                                            Padding="15" 
                                            WidthRequest="220" 
                                            StrokeThickness="0">
                                            <VerticalStackLayout Spacing="10">

                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 20" HeightRequest="40" WidthRequest="40" BackgroundColor="{Binding BudgetWrapper.Budget.Category.Color}" StrokeThickness="0">
                                                        <Label Text="{Binding BudgetWrapper.Budget.Category.Icon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                                                        <Label Text="{Binding BudgetWrapper.Budget.Category.Name}" TextColor="White" FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation"/>
                                                        <Label TextColor="#90A4AE" FontSize="12">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{x:Static strings:AppResources.Spent}" />

                                                                    <Span Text=": " />

                                                                    <Span Text="{Binding BudgetWrapper.Spent, StringFormat='{0:C0}'}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <Border Stroke="#4B5563" StrokeThickness="1" StrokeShape="RoundRectangle 4" BackgroundColor="#2E3748" Padding="0">
                                                    <AbsoluteLayout HeightRequest="8">

                                                        <ProgressBar Progress="{Binding BudgetWrapper.Percentage}" 
                                                             ProgressColor="{Binding BudgetWrapper.ProgressColor}" 
                                                             BackgroundColor="Transparent"
                                                             AbsoluteLayout.LayoutFlags="All"
                                                             AbsoluteLayout.LayoutBounds="0, 0, 1, 1"/>

                                                        <BoxView Color="White" WidthRequest="2"
                                                             AbsoluteLayout.LayoutFlags="PositionProportional, HeightProportional"
                                                             AbsoluteLayout.LayoutBounds="{Binding MarkerBounds}">
                                                            <BoxView.Shadow>
                                                                <Shadow Brush="Black" Offset="0,0" Radius="2" Opacity="0.8"/>
                                                            </BoxView.Shadow>
                                                        </BoxView>
                                                    </AbsoluteLayout>
                                                </Border>

                                                <Label Text="{Binding BudgetWrapper.Budget.Goal, StringFormat='Cel: {0:C0}'}" TextColor="#6B7280" FontSize="10" HorizontalOptions="End"/>

                                            </VerticalStackLayout>
                                        </Border>

                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <Label Text="{x:Static strings:AppResources.RecentOperations}" TextColor="#B0BEC5" FontSize="14" FontAttributes="Bold" Margin="5,10,0,0"/>
                    <Border Style="{StaticResource ElevatedCardBorderStyle}" Padding="15" Margin="0, 15, 0, 5" StrokeThickness="0" IsVisible="{Binding HasUpcomingTransactions}">
                        <VerticalStackLayout Spacing="15" >

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{x:Static strings:AppResources.UpcomingTransactions}" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                                <Label Grid.Column="1" Text="📅" FontSize="14"/>
                            </Grid>


                            <VerticalStackLayout 
                                         BindableLayout.ItemsSource="{Binding UpcomingTransactionsList}"
                                         Spacing="10">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:AutomatedTransaction">
                                        <Grid ColumnDefinitions="Auto,Auto, *, Auto" ColumnSpacing="15">

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" WidthRequest="35">
                                                <Label Text="{Binding NextTime, StringFormat='{0:dd}'}" 
                                               TextColor="White" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center"/>
                                                <Label Text="{Binding NextTime, StringFormat='{0:MMM}'}" 
                                               TextColor="#00BFA5" FontSize="9" TextTransform="Uppercase" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>

                                            <Border Grid.Column="0" StrokeShape="RoundRectangle 30"
                                                    HeightRequest="40" WidthRequest="40"
                                                    BackgroundColor="{Binding Category.Color}"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Center" 
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Category.Icon}" 
                                                   FontSize="25" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"
                                                      Margin="0,0,0,5" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Name}" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                                <Label Text="{x:Static strings:AppResources.Transaction}" TextColor="#90A4AE" FontSize="11"/>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="3" 
                                                   Text="{Binding Amount, StringFormat='{0:C0}'}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="15"
                                                   VerticalOptions="Center"/>


                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
                
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:GroupedTransactions">
                    <Grid Padding="20,15,20,5">
                        <Border BackgroundColor="#252A36" StrokeShape="RoundRectangle 10" Padding="10,5" HorizontalOptions="Start">
                            <Label Text="{Binding GroupDate, StringFormat='{0:dd MMMM}'}" 
                                   TextColor="#80CBC4" FontSize="12" FontAttributes="Bold" TextTransform="Uppercase"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Transactions">
                    <SwipeView>
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItemView BackgroundColor="#EF5350"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPageViewModel}}, Path=Delete_TransactionCommand}"
                                       CommandParameter="{Binding .}">

                                    <VerticalStackLayout VerticalOptions="Center" 
                                         HorizontalOptions="Center" 
                                         WidthRequest="90" 
                                         Spacing="5">

                                        <Image Source="delete.svg" 
                                               HeightRequest="20" 
                                               WidthRequest="20" 
                                               HorizontalOptions="Center"/> 

                                        <Label Text="{x:Static strings:AppResources.Delete}" 
                                       TextColor="White" 
                                       FontSize="13" 
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                                    </VerticalStackLayout>

                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <Border Style="{StaticResource ElevatedCardBorderStyle}"
                                Margin="20,0"
                                StrokeThickness="0"
                                Padding="15">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPageViewModel}}, Path=Edit_TransactionCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">

                                <Border Grid.Column="0" StrokeShape="RoundRectangle 30"
                                    HeightRequest="40" WidthRequest="40"
                                    BackgroundColor="{Binding Category.Color}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center">
                                       <Label Text="{Binding Category.Icon}" 
                                       FontSize="25" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"
                                          Margin="0,0,0,5" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                    <Label Text="Transakcja" TextColor="#90A4AE" FontSize="11"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2" 
                                       Text="{Binding Amount, StringFormat='{0:C0}'}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="100" Color="#1A1F2B"/>
            </CollectionView.Footer>
        </CollectionView>

        <Grid HorizontalOptions="End"
              VerticalOptions="End"
              Margin="20"
              WidthRequest="200" 
              HeightRequest="300"
              InputTransparent="True"
              CascadeInputTransparent="False">

            <HorizontalStackLayout x:Name="IncomeBtn" 
                                   Spacing="15" 
                                   HorizontalOptions="End" 
                                   VerticalOptions="End"
                                   Opacity="0"
                                   Scale="0.8"
                                   ZIndex="1"
                                   InputTransparent="True"
                                   TranslationY="0">
                <Border BackgroundColor="#263238" StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center" StrokeThickness="0">
                    <Label Text="{x:Static strings:AppResources.Income}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                </Border>
                <Button Text="+" 
                        Command="{Binding New_IncomeCommand}"
                        BackgroundColor="#2E7D32"
                        TextColor="White"
                        FontSize="20"
                        CornerRadius="25" HeightRequest="50" WidthRequest="50" InputTransparent="False">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.5" Radius="5"/>
                    </Button.Shadow>
                </Button>
            </HorizontalStackLayout>

            <HorizontalStackLayout x:Name="ExpenseBtn" 
                                   Spacing="15"
                                   HorizontalOptions="End" 
                                   VerticalOptions="End"
                                   Opacity="0"
                                   ZIndex="1"
                                   Scale="0.8"
                                   InputTransparent="True"
                                   TranslationY="0">
                <Border BackgroundColor="#263238" StrokeShape="RoundRectangle 8" Padding="8,4" VerticalOptions="Center" StrokeThickness="0">
                    <Label Text="{x:Static strings:AppResources.Expense}" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                </Border>
                <Button Text="-" 
                        Command="{Binding New_ExpenseCommand}"
                        BackgroundColor="#C62828"
                        TextColor="White"
                        FontSize="20"
                        CornerRadius="25" HeightRequest="50" WidthRequest="50" InputTransparent="False">
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Opacity="0.5" Radius="5"/>
                    </Button.Shadow>
                </Button>
            </HorizontalStackLayout>

            <Button x:Name="MainFab"
                    Text="+"
                    TextColor="White"
                    FontSize="30"
                    BackgroundColor="#00BFA5"
                    HeightRequest="60"
                    WidthRequest="60"
                    CornerRadius="30"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Clicked="MainFab_Clicked"
                    ZIndex="2"
                    InputTransparent="False">
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="0,5" Opacity="0.5" Radius="8"/>
                </Button.Shadow>
            </Button>
        </Grid>
    </Grid>
</ContentPage>