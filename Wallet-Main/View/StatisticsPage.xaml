<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wallet_Main.StatisticPage"
             xmlns:local="clr-namespace:Wallet_Main"
             xmlns:models="clr-namespace:Wallet_lib;assembly=Wallet_lib"
             BackgroundColor="#1A1F2B"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui">

    <Grid RowDefinitions="*">

        <CollectionView ItemsSource="{Binding MonthlyStatList}"
                        Margin="15">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="📊" FontSize="60" HorizontalOptions="Center"/>
                    <Label Text="Brak danych do wyświetlenia" 
                           TextColor="Gray" 
                           FontSize="18" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Header>
                <VerticalStackLayout  >
                    <Label Text="Przewidywanie bilansu" 
                           TextColor="WhiteSmoke" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           Margin="5,0"/>

                    <Grid HeightRequest="350">

                        <lvc:CartesianChart 
                            Series="{Binding SeriesList}" 
                            XAxes="{Binding XAxes}" 
                            LegendPosition="Hidden"
                            TooltipPosition="Top"
                            BackgroundColor="#273446"
                            Opacity="1"/>

                        <Border IsVisible="{Binding IsNotEnoughData}"
                            BackgroundColor="#CC1A1F2B" 
                            StrokeThickness="0"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill"
                            ZIndex="99">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" Padding="30">
                                <Label Text="📊" FontSize="50" HorizontalOptions="Center"/>

                                <Label Text="Zbieramy dane..." 
                                   TextColor="White" 
                                   FontSize="20" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center"/>

                                <Label Text="Aby odblokować zaawansowaną analizę statystyczną i trendy, korzystaj z aplikacji aktywnie przez minimum 3 miesiące." 
                                TextColor="#B0BEC5" 
                                FontSize="14" 
                                HorizontalTextAlignment="Center" 
                                HorizontalOptions="Center"/>     

                                <ProgressBar Progress="{Binding DataCollectionProgress}" ProgressColor="#00BFA5" WidthRequest="150"/>
                                <Label Text="{Binding DaysLeftText}" TextColor="#546E7A" FontSize="12" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>
            

            <CollectionView.ItemTemplate Margin="15" >
                <DataTemplate x:DataType="models:MonthlyStat">
                    <Border Style="{StaticResource ElevatedCardBorderStyle}">

                        <Grid ColumnDefinitions="Auto, *, *" Padding="15" ColumnSpacing="15">

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" WidthRequest="80">
                                <Label Text="{Binding Month_mmmm}" 
                                       TextColor="White" 
                                       Style="{StaticResource CardTitle}" 
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="Start"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="Przychód" FontSize="10" TextColor="#80CBC4" TextTransform="Uppercase"/>
                                <Label Text="{Binding Income, StringFormat='{0:C0}'}" 
                                       TextColor="#00BFA5" 
                                       FontAttributes="Bold"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                <Label Text="Wydatki" FontSize="10" TextColor="#EF9A9A" TextTransform="Uppercase"/>
                                <Label Text="{Binding Expenses, StringFormat='{0:C0}'}" 
                                       TextColor="#EF5350" 
                                       FontAttributes="Bold"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>