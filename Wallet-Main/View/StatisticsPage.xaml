<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wallet_Main.StatisticPage"
             xmlns:local="clr-namespace:Wallet_Main"
             x:DataType="local:StatisticViewModel"
             xmlns:models="clr-namespace:Wallet_lib;assembly=Wallet_lib"
             BackgroundColor="#1A1F2B"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:strings="clr-namespace:Wallet_Main.Resources.Strings">

    <Grid RowDefinitions="*">

        <CollectionView ItemsSource="{Binding MonthlyStatList}"
                        Margin="15">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="{x:Static strings:AppResources.NoData}" 
                           TextColor="Gray" 
                           FontSize="18" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="20" Padding="15">

                    <Border Style="{StaticResource CardBorderStyle}" IsVisible="{Binding IsNotEnoughData, Converter={toolkit:InvertedBoolConverter}}">
                        <Grid HeightRequest="350">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{x:Static strings:AppResources.MonthlyBalance}" 
                                   TextColor="WhiteSmoke" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   Margin="5,0"/>

                                <lvc:CartesianChart
                                    Series="{Binding SeriesListHistogram}"
                                    XAxes="{Binding XAxesHistogram}"
                                    YAxes="{Binding YAxesHistogram}"
                                    TooltipPosition="Top"
                                    BackgroundColor="#273446"
                                    Opacity="1"
                                    HeightRequest="250"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{x:Static strings:AppResources.BalanceProjection}" 
                               TextColor="WhiteSmoke" 
                               FontSize="18" 
                               FontAttributes="Bold"
                               Margin="5,0"/>

                            <Grid HeightRequest="350">
                                <lvc:CartesianChart 
                                    Series="{Binding SeriesList}" 
                                    XAxes="{Binding XAxes}" 
                                    YAxes="{Binding YAxes}"
                                    LegendPosition="Hidden"
                                    TooltipPosition="Top"
                                    BackgroundColor="#273446"
                                    Opacity="1"/>

                                <Border IsVisible="{Binding IsNotEnoughData}"
                                    BackgroundColor="#CC1A1F2B" 
                                    StrokeThickness="0"
                                    VerticalOptions="Fill"
                                    HorizontalOptions="Fill"
                                    ZIndex="99">

                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15" Padding="30">
                                        <Label Text="📊" FontSize="50" HorizontalOptions="Center"/>

                                        <Label Text="{x:Static strings:AppResources.CollectingData}" 
                                           TextColor="White" 
                                           FontSize="20" 
                                           FontAttributes="Bold" 
                                           HorizontalOptions="Center"/>

                                        <Label Text="{x:Static strings:AppResources.StatisticPageEmpty}" 
                                           TextColor="#B0BEC5" 
                                           FontSize="14" 
                                           HorizontalTextAlignment="Center" 
                                           HorizontalOptions="Center"/>

                                        <ProgressBar Progress="{Binding DataCollectionProgress}" ProgressColor="#00BFA5" WidthRequest="150"/>

                                        <Label Text="{Binding DaysLeftText}" TextColor="#546E7A" FontSize="12" HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Header>
            

            <CollectionView.ItemTemplate Margin="15" >
                <DataTemplate x:DataType="local:MonthlyStatService">
                    <VerticalStackLayout>
                    <Border Style="{StaticResource ElevatedCardBorderStyle}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:StatisticViewModel}}, Path=Expand_MonthCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto, *, *" Padding="15" ColumnSpacing="15">

                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" WidthRequest="80">
                                <Label Text="{Binding MonthlyStat.Month_mmmm}" 
                                       TextColor="White" 
                                       Style="{StaticResource CardTitle}" 
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       HorizontalOptions="Start"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{x:Static strings:AppResources.Income}" FontSize="10" TextColor="#80CBC4" TextTransform="Uppercase"/>
                                <Label Text="{Binding MonthlyStat.Income, StringFormat='{0:C0}'}" 
                                       TextColor="#00BFA5" 
                                       FontAttributes="Bold"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                <Label Text="{x:Static strings:AppResources.Expenses}" FontSize="10" TextColor="#EF9A9A" TextTransform="Uppercase"/>
                                <Label Text="{Binding MonthlyStat.Expenses, StringFormat='{0:C0}'}" 
                                       TextColor="#EF5350" 
                                       FontAttributes="Bold"
                                       FontSize="15"/>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                        <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                     BindableLayout.ItemsSource="{Binding MonthlyStat.CategoriesStats}"
                     Margin="35,5,5,15">

                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoriesStat">
                                    <Border Style="{StaticResource ElevatedCardBorderStyle}" Padding="0" Margin="0, 2">

                                        <Grid ColumnDefinitions="Auto, *, Auto" Padding="10, 5" ColumnSpacing="10">

                                            <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 20"
                                                HeightRequest="40" WidthRequest="40"
                                                BackgroundColor="{Binding Category.Color}"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">

                                                <Label Text="{Binding Category.Icon}"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,0,1"/>
                                            </Border>

                                            <Label Grid.Column="1"
                                               Text="{Binding Category.Name}"
                                               TextColor="#CFD8DC"
                                               FontSize="13"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"/>

                                            <Label Grid.Column="2"
                                               Text="{Binding Balance, StringFormat='{0:C}'}"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="White" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>