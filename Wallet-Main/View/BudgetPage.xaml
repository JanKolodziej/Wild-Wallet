<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wallet_Main.BudgetPage"
             xmlns:local="clr-namespace:Wallet_Main"
             xmlns:models="clr-namespace:Wallet_lib;assembly=Wallet_lib"
             BackgroundColor="#1A1F2B">

    <Grid>
        

    <CollectionView ItemsSource="{Binding Budgets}">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:BudgetWrapperDisplay">
                <Border Style="{StaticResource ElevatedCardBorderStyle}" Padding="15" Margin="10" StrokeThickness="0">
                    <VerticalStackLayout Spacing="10">

                        <Grid ColumnDefinitions="Auto, *, Auto">

                            <Border Grid.Column="0" StrokeShape="RoundRectangle 20" HeightRequest="40" WidthRequest="40" BackgroundColor="{Binding BudgetWrapper.Budget.Category.Color}" StrokeThickness="0">
                                <Label Text="{Binding BudgetWrapper.Budget.Category.Icon}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                                <Label Text="{Binding BudgetWrapper.Budget.Category.Name}" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                    <Label Text="{Binding BudgetWrapper.Spent, StringFormat='Wydano: {0:C0}'}" TextColor="#90A4AE" FontSize="12"/>
                            </VerticalStackLayout>


                        </Grid>

                            <VerticalStackLayout Spacing="5">

                                <Border Stroke="#4B5563" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 4"
                                    BackgroundColor="#2E3748"
                                    Padding="0">

                                    <AbsoluteLayout HeightRequest="8">

                                        <ProgressBar Progress="{Binding BudgetWrapper.Percentage}" 
                                             ProgressColor="{Binding BudgetWrapper.ProgressColor}" 
                                             BackgroundColor="Transparent"
                                             AbsoluteLayout.LayoutFlags="All"
                                             AbsoluteLayout.LayoutBounds="0, 0, 1, 1"/>

                                        <BoxView Color="White"
                                             WidthRequest="2"
                                             AbsoluteLayout.LayoutFlags="PositionProportional, HeightProportional"
                                             AbsoluteLayout.LayoutBounds="{Binding MarkerBounds}">  
                                            <BoxView.Shadow>
                                                <Shadow Brush="Black" Offset="0,0" Radius="2" Opacity="0.8"/>
                                            </BoxView.Shadow>
                                        </BoxView>

                                    </AbsoluteLayout>
                                </Border>

                                <Label Text="{Binding BudgetWrapper.Budget.Goal, StringFormat='Cel: {0:C0}'}" 
                                   TextColor="#90A4AE" 
                                   FontSize="11" 
                                   HorizontalOptions="End"/>

                            </VerticalStackLayout>

                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:BudgetViewModel}}, Path=Show_Add_Budget_PopUpCommand}"
                                CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                    </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
        <Button 
            Margin="20"
            Text="+"
            TextColor="White"
            FontSize="30"
            BackgroundColor="#00BFA5"
            HeightRequest="60"
            WidthRequest="60"
            CornerRadius="30"
            HorizontalOptions="End"
            VerticalOptions="End"
            Command="{Binding Show_Add_Budget_PopUpCommand}"
            ZIndex="2"
            InputTransparent="False">
            <Button.Shadow>
                <Shadow Brush="Black" Offset="0,5" Opacity="0.5" Radius="8"/>
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>