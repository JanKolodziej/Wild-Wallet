<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Wallet_Main.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wallet_Main"
    Title="Wallet_Main"
    BackgroundColor="#1A1F2B"
FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="200" BackgroundColor="SlateGray">
            <Label Text="Witaj Użytkowniku!" 
                   TextColor="{StaticResource White}"
                   VerticalOptions="Center" 
                   HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Strona Główna">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Statystyki" >
        <ShellContent ContentTemplate="{DataTemplate local:StatisticPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Zaplanowane Płatności">
        <ShellContent ContentTemplate="{DataTemplate local:ScheduledPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Budżety">
        <ShellContent ContentTemplate="{DataTemplate local:BudgetPage}" />
    </FlyoutItem>




</Shell>
