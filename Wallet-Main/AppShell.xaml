    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wallet_Main"
    Title="Wallet_Main"
FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="200" BackgroundColor="SlateGray">
            <Label Text="Witaj Użytkowniku!" 
