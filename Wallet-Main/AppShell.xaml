                   VerticalOptions="Center" 
                   HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Strona Główna">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="" >
        <!--<ShellContent ContentTemplate="{DataTemplate local:}" />-->
    </FlyoutItem>

    <FlyoutItem Title="">
        <!--<ShellContent ContentTemplate="{DataTemplate local:}" />-->
    </FlyoutItem>



</Shell>
