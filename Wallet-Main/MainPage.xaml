<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local ="clr-namespace:Wallet_Main"
             x:Class="Wallet_Main.MainPage"
             BackgroundColor="#212735">

    <ScrollView>
       
            
        
        <FlexLayout Wrap="Wrap"  AlignItems="Start" Margin="0">
            
                <Border Style="{StaticResource ElevatedCardBorderStyle}">
                <VerticalStackLayout>
                    <Label Text="Wpływy" Style="{StaticResource CardTitle}"/>
                    <Label Text="{Binding Income}" Style="{StaticResource CardValueLarge}"/>
                </VerticalStackLayout>
                    
                </Border>
                <Border Style="{StaticResource ElevatedCardBorderStyle}">
                <VerticalStackLayout>
                    <Label Text="Wydatki" Style="{StaticResource CardTitle}"/>
                    <Label Text="{Binding Expenses}" Style="{StaticResource CardValueLarge}"/>
                </VerticalStackLayout>
            </Border>

            
            <Border Style="{StaticResource ElevatedCardBorderStyle}"> 
                <Label Text="Testowy Tekst" Style="{StaticResource CardTitle}"/>
            </Border>
            
                <Button Text="+"
               TextColor="White"
               BackgroundColor="CadetBlue"
               HorizontalOptions="End"
               VerticalOptions="End"
               Command="{Binding NewTransactionCommand}"/>  
            

        </FlexLayout>
      
    </ScrollView>

</ContentPage>
